{
  "name": "pokemon-tracker-backend",
  "version": "1.0.0",
  "description": "Pokemon card collection tracker API",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "nodemon --exec \"node --experimental-sqlite -r ts-node/register\" src/index.ts",
    "build": "tsc",
    "start": "node --experimental-sqlite dist/index.js",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  }
}
